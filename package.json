{
  "name": "fleetforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,agent 'vite --host 127.0.0.1' 'tsx watch --env-file-if-exists=.env server/index.ts'",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:core": "vitest run tests/core",
    "test:server": "vitest run tests/server",
    "test:browser": "playwright test",
    "check": "npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
